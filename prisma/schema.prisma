generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------------------
// Enums
// --------------------------------------------------

enum Role {
  customer
  admin
}

enum ProductStatus {
  active
  draft
  archived
}

enum OrderStatus {
  pending
  processing
  shipped
  delivered
  cancelled
}

enum PaymentStatus {
  pending
  paid
  cash_on_delivery
  failed
  refunded
}

enum InventoryReason {
  restock
  order_created
  order_cancelled
  adjustment
  damage
  return_restock
}

enum VariantStatus {
  active
  inactive
}

// --------------------------------------------------
// Models
// --------------------------------------------------

// 1. Single-Level Category Model
model Category {
  id                 String              @id @default(cuid())
  name               String
  nameAr             String
  slug               String              @unique
  itemCount          Int                 @default(0)
  image              String
  banner             String?
  iconName           String?
  description        String?
  descriptionAr      String?
  isActive           Boolean             @default(true)
  isFeatured         Boolean             @default(false)
  displayOrder       Int                 @default(0)
  seoTitle           String?
  seoDescription     String?
  seoKeywords        String?
  isArchived         Boolean             @default(false)
  products           Product[]
  assignedAttributes CategoryAttribute[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @default(now()) @updatedAt
}

// 2. Attribute Group (e.g. Performance, Display, Storage, General)
model AttributeGroup {
  id           String      @id @default(cuid())
  name         String
  nameAr       String
  displayOrder Int         @default(0)
  attributes   Attribute[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

// 3. Dynamic Attribute (e.g. RAM, GPU, Screen Size, Processor, Color)
model Attribute {
  id                  String                  @id @default(cuid())
  name                String
  nameAr              String
  slug                String                  @unique
  type                String                  @default("select")
  unit                String?
  options             Json?
  groupId             String
  group               AttributeGroup          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  categoryAssignments CategoryAttribute[]
  productValues       ProductAttributeValue[]
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
}

// 4. Category-to-Attribute Assignment (Dynamic Filter & Spec Configuration)
model CategoryAttribute {
  id                     String    @id @default(cuid())
  categoryId             String
  category               Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attributeId            String
  attribute              Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  isRequired             Boolean   @default(false)
  displayOrder           Int       @default(0)
  isFilterable           Boolean   @default(true)
  isSearchable           Boolean   @default(true)
  isComparable           Boolean   @default(true)
  isVisibleOnProductPage Boolean   @default(true)
  isVariantOption        Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@unique([categoryId, attributeId])
}

// 5. Product Model
model Product {
  id                    String                  @id
  name                  String
  nameAr                String
  brand                 String
  categoryId            String
  category              Category                @relation(fields: [categoryId], references: [id])
  sku                   String                  @unique
  barcode               String?
  price                 Decimal                 @db.Decimal(12, 2)
  oldPrice              Decimal?                @db.Decimal(12, 2)
  costPrice             Decimal?                @db.Decimal(12, 2)
  compareAtPrice        Decimal?                @db.Decimal(12, 2)
  discountPercentage    Int?
  inStock               Boolean                 @default(true)
  stockCount            Int                     @default(10)
  lowStockThreshold     Int                     @default(5)
  trackInventory        Boolean                 @default(true)
  allowBackorders       Boolean                 @default(false)
  shipsWithin           String                  @default("Ships within 24 hours")
  shipsWithinAr         String                  @default("??? ????? ???? 24 ????")
  isNew                 Boolean                 @default(false)
  isBestSeller          Boolean                 @default(false)
  isDeal                Boolean                 @default(false)
  dealEndsIn            String?
  status                ProductStatus           @default(active)
  weight                Float?
  thumbnail             String
  images                Json                    @default("[]")
  description           String
  descriptionAr         String
  specs                 Json                    @default("{}")
  specsAr               Json?
  features              Json?
  featuresAr            Json?
  monthlyValue          Decimal?                @db.Decimal(12, 2)
  monthlyAman           Decimal?                @db.Decimal(12, 2)
  seoTitle              String?
  metaDescription       String?
  searchKeywords        String?
  isArchived            Boolean                 @default(false)
  variants              ProductVariant[]
  attributeValues       ProductAttributeValue[]
  inventoryTransactions InventoryTransaction[]
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
}

// 6. Product Attribute Values (EAV Dynamic Specs)
model ProductAttributeValue {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeId String
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  textValue   String?
  numberValue Float?
  booleanValue Boolean?
  jsonValue   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([productId, attributeId])
}

// 7. Product Variants
model ProductVariant {
  id                    String                 @id @default(cuid())
  productId             String
  product               Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku                   String                 @unique
  barcode               String?
  price                 Decimal                @db.Decimal(12, 2)
  oldPrice              Decimal?               @db.Decimal(12, 2)
  costPrice             Decimal?               @db.Decimal(12, 2)
  stockCount            Int                    @default(0)
  image                 String?
  status                VariantStatus          @default(active)
  options               Json
  inventoryTransactions InventoryTransaction[]
  orderItems            OrderItem[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@unique([productId, sku])
}

// 8. Inventory Transactions
model InventoryTransaction {
  id            String          @id @default(cuid())
  productId     String
  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId     String?
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantityDelta Int
  previousStock Int
  newStock      Int
  reason        InventoryReason
  createdById   String?
  createdByName String?
  createdAt     DateTime        @default(now())
}

// 9. Audit Logs
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  userName   String?
  userEmail  String?
  action     String
  entityType String
  entityId   String
  details    Json
  ipAddress  String?
  createdAt  DateTime @default(now())
}

// 10. Order Model
model Order {
  id            String        @id
  createdAt     DateTime      @default(now())
  customerName  String
  customerEmail String
  customerPhone String
  city          String
  address       String
  postalCode    String?
  isCorporate   Boolean       @default(false)
  companyName   String?
  taxNumber     String?
  paymentMethod String
  paymentStatus PaymentStatus @default(pending)
  orderStatus   OrderStatus   @default(processing)
  subtotal      Decimal       @db.Decimal(12, 2)
  shipping      Decimal       @db.Decimal(12, 2)
  vat           Decimal       @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  notes         String?
  items         OrderItem[]
}

// 11. Order Items
model OrderItem {
  id              String          @id @default(cuid())
  orderId         String
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String
  variantId       String?
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName     String
  productNameAr   String?
  quantity        Int
  unitPrice       Decimal         @db.Decimal(12, 2)
  totalPrice      Decimal         @db.Decimal(12, 2)
  selectedOptions Json?
}

// 12. Coupon Model
model Coupon {
  id             String   @id @default(cuid())
  code           String   @unique
  discountAmount Decimal  @db.Decimal(12, 2)
  minSpend       Decimal  @default(0) @db.Decimal(12, 2)
  isActive       Boolean  @default(true)
}

// 13. User Model
model User {
  id        String         @id @default(cuid())
  name      String
  email     String         @unique
  phone     String
  password  String?
  role      Role           @default(customer)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  addresses SavedAddress[]
}

// 14. Saved Addresses
model SavedAddress {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  fullName       String
  phone          String
  city           String
  addressDetails String
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
}
